# Copy to backend/.env and adjust. Every setting in src/planner/config.py can be set as PLANNER_<NAME>.
PLANNER_JWT_SECRET=change-me-to-a-long-random-string
# mock = built-in stand-in models; openai = OpenAI-compatible server configured in config/models.yaml
PLANNER_MODELS_BACKEND=mock
PLANNER_SCHEDULER_INTERVAL_SECONDS=300
PLANNER_PUSH_ENABLED=false
PLANNER_DEV_ENDPOINTS_ENABLED=true
